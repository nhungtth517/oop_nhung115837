class SystemInterface {
private:
    int suc_chua_he_thong;
    int so_bai;
    bai_xe** ds_bai;

    void khoi_tao_mang(int n) {
        ds_bai = new bai_xe*[n];

        for (int i = 0; i < n; i++)
            ds_bai[i] = nullptr;
    }

    void don_dep() {
        for (int i = 0; i < so_bai; i++) {
            delete ds_bai[i];
            ds_bai[i] = nullptr;
        }

        delete[] ds_bai;
        ds_bai = nullptr;
    }

    void chep_tu(const SystemInterface& s) {
        suc_chua_he_thong = s.suc_chua_he_thong;
        so_bai = s.so_bai;

        khoi_tao_mang(suc_chua_he_thong);

        for (int i = 0; i < so_bai; i++)
            ds_bai[i] = new bai_xe(*s.ds_bai[i]);
    }

    int nhap_so(string nhac, int min, int max) {
        int x;

        while (true) {
            cout << nhac;
            cin >> x;

            if (cin.fail()) {
                cout << "Loi: phai nhap so nguyen!" << endl;
                cin.clear();
                cin.ignore(1000, '\n');
            }
            else if (x < min || x > max) {
                cout << "Gia tri phai tu "
                     << min << " den " << max << "!" << endl;
            }
            else {
                return x;
            }
        }
    }

    string nhap_loai() {
        string s;

        while (true) {
            cout << "Loai xe (Car/Motorcycle/Bicycle): ";
            cin >> s;

            for (int i = 0; i < (int)s.length(); i++)
                s[i] = tolower((unsigned char)s[i]);

            if (s == "car") return "Car";
            if (s == "motorcycle") return "Motorcycle";
            if (s == "bicycle") return "Bicycle";

            cout << "Loai xe khong hop le!" << endl;
        }
    }

    int tim_bai(int ma) const {
        for (int i = 0; i < so_bai; i++) {
            if (ds_bai[i]->lay_ma() == ma)
                return i;
        }

        return -1;
    }

    bool ton_tai_ma_bai(int ma) const {
        return tim_bai(ma) != -1;
    }

    bool ton_tai_ma_xe(int ma) const {
        for (int i = 0; i < so_bai; i++) {
            if (ds_bai[i]->tim_chi_so(ma) != -1)
                return true;
        }

        return false;
    }

    int sinh_ma_ngau_nhien() {
        return rand() % 9000 + 1000;
    }

public:
    SystemInterface() {
        suc_chua_he_thong = 2;
        so_bai = 0;
        khoi_tao_mang(suc_chua_he_thong);
    }

    ~SystemInterface() {
        don_dep();
    }

    SystemInterface(const SystemInterface& s) {
        chep_tu(s);
    }

    SystemInterface& operator=(const SystemInterface& s) {
        if (this != &s) {
            don_dep();
            chep_tu(s);
        }

        return *this;
    }

    void resizeSystem(int suc_chua_moi) {
        if (suc_chua_moi <= suc_chua_he_thong)
            return;

        bai_xe** mang_moi =
            new bai_xe*[suc_chua_moi];

        for (int i = 0; i < suc_chua_moi; i++)
            mang_moi[i] = nullptr;

        for (int i = 0; i < so_bai; i++)
            mang_moi[i] = ds_bai[i];

        delete[] ds_bai;

        ds_bai = mang_moi;
        suc_chua_he_thong = suc_chua_moi;
    }

    void runMenu() {
        int chon;

        do {
            cout << "\n===== QUAN LY BAI DO XE =====\n"
                 << "1. Tao bai do\n"
                 << "2. Them xe\n"
                 << "3. Xoa bai do\n"
                 << "4. Lay xe ra\n"
                 << "5. Hien thi tat ca bai do\n"
                 << "6. Hien thi xe theo bai\n"
                 << "7. Liet ke xe theo loai\n"
                 << "8. Bao cao phi trung binh\n"
                 << "9. Thoat\n";

            chon = nhap_so("Chon: ", 1, 9);

            switch (chon) {

            case 1: {
                int ma = nhap_so("Ma bai: ", 1, 999999);

                char kt;

                do {
                    cout << "Kich thuoc (S/M/L): ";
                    cin >> kt;
                    kt = toupper((unsigned char)kt);
                } while (kt != 'S' && kt != 'M' && kt != 'L');

                if (ton_tai_ma_bai(ma)) {
                    do {
                        ma = sinh_ma_ngau_nhien();
                    } while (ton_tai_ma_bai(ma));

                    cout << "Canh bao: ma bai bi trung! Ma moi: "
                         << ma << endl;
                }

                if (so_bai == suc_chua_he_thong) {
                    resizeSystem(suc_chua_he_thong * 2);

                    cout << "(He thong tu mo rong len "
                         << suc_chua_he_thong << " bai)" << endl;
                }

                ds_bai[so_bai] = new bai_xe(ma, kt);
                so_bai++;

                cout << "Da tao bai " << ma << endl;
                break;
            }

            case 2: {
                if (so_bai == 0) {
                    cout << "Chua co bai do nao!" << endl;
                    break;
                }

                int ma = nhap_so("Ma xe: ", 1, 999999);
                string loai = nhap_loai();
                int gio = nhap_so("Gio vao (0-23): ", 0, 23);
                int tg = nhap_so("Thoi luong (1-23): ", 1, 23);

                int vt = -1;

                for (int i = 0; i < so_bai && vt == -1; i++) {
                    if (!ds_bai[i]->la_day())
                        vt = i;
                }

                if (vt == -1) {
                    cout << "Canh bao: khong con bai nao con cho!"
                         << endl;
                    break;
                }

                if (ton_tai_ma_xe(ma)) {
                    do {
                        ma = sinh_ma_ngau_nhien();
                    } while (ton_tai_ma_xe(ma));

                    cout << "Canh bao: ma xe bi trung! Ma moi: "
                         << ma << endl;
                }

                phuong_tien v(ma, loai, gio, tg);

                ds_bai[vt]->them(v);

                cout << "Da them xe " << ma
                     << " vao bai " << ds_bai[vt]->lay_ma()
                     << " | Phi: $" << fixed << setprecision(2)
                     << v.tinh_phi() << endl;

                break;
            }

            case 3: {
                int vt = tim_bai(
                    nhap_so("Ma bai can xoa: ", 1, 999999)
                );

                if (vt == -1) {
                    cout << "Khong tim thay bai!" << endl;
                    break;
                }

                delete ds_bai[vt];

                for (int i = vt; i < so_bai - 1; i++)
                    ds_bai[i] = ds_bai[i + 1];

                ds_bai[so_bai - 1] = nullptr;
                so_bai--;

                cout << "Da xoa bai" << endl;
                break;
            }

            case 4: {
                int ma = nhap_so("Ma xe can lay ra: ", 1, 999999);

                bool ok = false;

                for (int i = 0; i < so_bai && !ok; i++)
                    ok = ds_bai[i]->xoa(ma);

                cout << (ok ? "Da lay xe ra" : "Khong tim thay xe")
                     << endl;

                break;
            }

            case 5: {
                if (so_bai == 0)
                    cout << "Chua co bai do nao." << endl;

                for (int i = 0; i < so_bai; i++)
                    ds_bai[i]->hien_thi();

                break;
            }

            case 6: {
                int vt = tim_bai(
                    nhap_so("Ma bai: ", 1, 999999)
                );

                if (vt == -1)
                    cout << "Khong tim thay bai!" << endl;
                else
                    ds_bai[vt]->hien_thi();

                break;
            }

            case 7: {
                string loai = nhap_loai();
                bool co_xe = false;

                for (int i = 0; i < so_bai; i++) {
                    int dem;
                    double phi;

                    ds_bai[i]->thong_ke(loai, dem, phi);

                    if (dem > 0) {
                        ds_bai[i]->hien_thi();
                        co_xe = true;
                    }
                }

                if (!co_xe)
                    cout << "Khong co xe loai "
                         << loai << endl;

                break;
            }

            case 8: {
                string cac_loai[3] = {
                    "Car", "Motorcycle", "Bicycle"
                };

                cout << fixed << setprecision(2);

                for (int t = 0; t < 3; t++) {
                    int tong_dem = 0;
                    double tong_phi = 0;

                    for (int i = 0; i < so_bai; i++) {
                        int dem;
                        double phi;

                        ds_bai[i]->thong_ke(
                            cac_loai[t], dem, phi
                        );

                        tong_dem += dem;
                        tong_phi += phi;
                    }

                    cout << cac_loai[t]
                         << " (toan he thong): ";

                    if (tong_dem == 0)
                        cout << "khong co xe" << endl;
                    else
                        cout << "TB $" << tong_phi / tong_dem
                             << endl;

                    for (int i = 0; i < so_bai; i++) {
                        int dem;
                        double phi;

                        ds_bai[i]->thong_ke(
                            cac_loai[t], dem, phi
                        );

                        if (dem > 0) {
                            cout << "   Bai "
                                 << ds_bai[i]->lay_ma()
                                 << ": TB $" << phi / dem
                                 << endl;
                        }
                    }
                }

                break;
            }

            case 9:
                cout << "Tam biet!" << endl;
                break;
            }

        } while (chon != 9);
    }
};

