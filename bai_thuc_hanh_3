using namespace std;

class phuong_tien {
private:
    int ma_xe;
    string loai_xe;
    int gio_vao, tg_do;

public:
    phuong_tien() {
        ma_xe = 0;
        loai_xe = "";
        gio_vao = 0;
        tg_do = 0;
    }

    phuong_tien(int ma, string loai, int gio, int tg) {
        ma_xe = ma;
        loai_xe = loai;
        gio_vao = gio;
        tg_do = tg;
    }

    int lay_ma_xe() const {
        return ma_xe;
    }

    string lay_loai_xe() const {
        return loai_xe;
    }

    double tinh_phi() const {
        double gia = 2.0;

        if (loai_xe == "Car") gia = 6.0;
        else if (loai_xe == "Motorcycle") gia = 4.0;

        bool cao_diem =
            (gio_vao >= 6 && gio_vao <= 9) ||
            (gio_vao >= 15 && gio_vao <= 18);

        double tong = 0;

        for (int h = 0; h < tg_do; h++) {
            if (h >= 2)
                tong += gia * 0.90;
            else if (cao_diem)
                tong += gia * 1.30;
            else
                tong += gia * 0.95;
        }

        return tong;
    }

    void hien_thi() const {
        cout << "  ID: " << ma_xe
             << " | " << loai_xe
             << " | " << gio_vao << "h"
             << " | " << tg_do << "h"
             << " | Phi: $" << fixed
             << setprecision(2) << tinh_phi() << endl;
    }
};

// =================================================

class bai_xe {
private:
    int suc_chua_hien_tai;
    int ma_bai;
    char kich_thuoc;

    phuong_tien** ds_xe;
    int so_xe;

    void khoi_tao_mang(int n) {
        ds_xe = new phuong_tien*[n];

        for (int i = 0; i < n; i++)
            ds_xe[i] = nullptr;
    }

    void don_dep() {
        for (int i = 0; i < so_xe; i++) {
            delete ds_xe[i];
            ds_xe[i] = nullptr;
        }

        delete[] ds_xe;
        ds_xe = nullptr;
    }

    void chep_tu(const bai_xe& b) {
        ma_bai = b.ma_bai;
        kich_thuoc = b.kich_thuoc;
        suc_chua_hien_tai = b.suc_chua_hien_tai;
        so_xe = b.so_xe;

        khoi_tao_mang(suc_chua_hien_tai);

        for (int i = 0; i < so_xe; i++)
            ds_xe[i] = new phuong_tien(*b.ds_xe[i]);
    }

public:
    bai_xe(int ma, char kt) {
        ma_bai = ma;
        kich_thuoc = kt;

        if (kt == 'S')
            suc_chua_hien_tai = 1;
        else if (kt == 'M')
            suc_chua_hien_tai = 2;
        else
            suc_chua_hien_tai = 3;

        so_xe = 0;
        khoi_tao_mang(suc_chua_hien_tai);
    }

    ~bai_xe() {
        don_dep();
    }

    bai_xe(const bai_xe& b) {
        chep_tu(b);
    }

    bai_xe& operator=(const bai_xe& b) {
        if (this != &b) {
            don_dep();
            chep_tu(b);
        }
        return *this;
    }

    int lay_ma() const {
        return ma_bai;
    }

    int suc_chua() const {
        return suc_chua_hien_tai;
    }

    bool la_day() const {
        return so_xe >= suc_chua_hien_tai;
    }

    void resize(int suc_chua_moi) {
        if (suc_chua_moi <= suc_chua_hien_tai)
            return;

        phuong_tien** mang_moi =
            new phuong_tien*[suc_chua_moi];

        for (int i = 0; i < suc_chua_moi; i++)
            mang_moi[i] = nullptr;

        for (int i = 0; i < so_xe; i++)
            mang_moi[i] = ds_xe[i];

        delete[] ds_xe;

        ds_xe = mang_moi;
        suc_chua_hien_tai = suc_chua_moi;
    }

    bool them(const phuong_tien& v) {
        if (so_xe == suc_chua_hien_tai) {
            resize(suc_chua_hien_tai * 2);

            cout << "(Bai " << ma_bai
                 << " day, tu mo rong len "
                 << suc_chua_hien_tai
                 << " cho)" << endl;
        }

        ds_xe[so_xe] = new phuong_tien(v);
        so_xe++;

        return true;
    }

    int tim_chi_so(int ma) const {
        for (int i = 0; i < so_xe; i++) {
            if (ds_xe[i]->lay_ma_xe() == ma)
                return i;
        }

        return -1;
    }

    bool xoa(int ma) {
        int vt = tim_chi_so(ma);

        if (vt == -1)
            return false;

        delete ds_xe[vt];

        for (int i = vt; i < so_xe - 1; i++)
            ds_xe[i] = ds_xe[i + 1];

        ds_xe[so_xe - 1] = nullptr;
        so_xe--;

        return true;
    }

    void hien_thi() const {
        cout << "Bai " << ma_bai
             << " [" << kich_thuoc << "] "
             << so_xe << "/" << suc_chua_hien_tai
             << " xe" << endl;

        for (int i = 0; i < so_xe; i++)
            ds_xe[i]->hien_thi();
    }

    void thong_ke(string loai, int& dem, double& tong) const {
        dem = 0;
        tong = 0;

        for (int i = 0; i < so_xe; i++) {
            if (ds_xe[i]->lay_loai_xe() == loai) {
                dem++;
                tong += ds_xe[i]->tinh_phi();
            }
        }
    }
};

